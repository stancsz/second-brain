# Keep synchronized text and exported OKF Markdown stable across platforms.
* text=auto eol=lf

*.py text eol=lf
*.md text eol=lf
*.sql text eol=lf

# Binary assets must not receive text conversion or line-ending diffs.
*.gif binary
*.ico binary
*.jpeg binary
*.jpg binary
*.pdf binary
*.png binary
*.sqlite binary
*.sqlite3 binary
*.tar binary
*.gz binary
*.zip binary
*.mp3 binary
*.mp4 binary
*.otf binary
*.ttf binary
*.woff binary
*.woff2 binary
